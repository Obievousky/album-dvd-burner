APP_VERSION=latest

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=album_dvd
POSTGRES_USER=album_dvd
POSTGRES_PASSWORD=album_dvd

# Data root — all album workspaces live here (host path)
DATA_ROOT=/opt/album-dvd-burner

# DVD burner
DVD_DEVICE=/dev/sr0
DVD_STANDARD=ntsc

# Fixed, non-root service account. Run docker/provision.sh to assign DATA_ROOT.
APP_UID=10001
APP_GID=10001
# Numeric group of the DVD device. Find it with: stat -c '%g' /dev/sr0
DVD_GID=24

# Web UI
WEB_PORT=8080
WEB_API_KEY=

# Burn ID format: R.P. No. 001 - RE
BURN_ID_PREFIX=R.P. No.

# Hours before unselected files are deleted (0 = delete immediately)
RETENTION_DELAY_HOURS=3
