# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=album_dvd
POSTGRES_USER=album_dvd
POSTGRES_PASSWORD=album_dvd

# Data root — all album workspaces live here (host path)
DATA_ROOT=./data

# DVD burner
DVD_DEVICE=/dev/sr0
DVD_STANDARD=ntsc
# Set to true only on a Linux host/VM where the optical drive is passed through.
DVD_PRIVILEGED=false

# File ownership inside the container. On Linux, set these to `id -u` and `id -g`.
LOCAL_UID=1000
LOCAL_GID=1000

# Web UI
WEB_PORT=8080
WEB_API_KEY=

# Burn ID format: R.P. No. 001 - RE
BURN_ID_PREFIX=R.P. No.

# Hours before unselected files are deleted (0 = delete immediately)
RETENTION_DELAY_HOURS=3
